# Cloudflare R2 settings for `regista data remote ...`.
# Copy to .env (git-ignored), fill in, and run: uv run --env-file .env regista data remote <command>
# Never commit .env or paste these values anywhere.
REGISTA_R2_ACCOUNT_ID=
REGISTA_R2_ACCESS_KEY_ID=
REGISTA_R2_SECRET_ACCESS_KEY=
REGISTA_R2_BUCKET=regista-data
